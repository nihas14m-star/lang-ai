# ---- AI Providers (all optional; backend falls back to the local rule-based tutor when none are set) ----

# NVIDIA NIM — primary provider
# Get a key at https://build.nvidia.com (free credits available)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Fallback providers (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Force a provider order: nvidia,openai,gemini,openrouter,mock (default: auto)
AI_PROVIDER_ORDER=

# ---- Server ----
PORT=8787

# Optional shared bearer token. When set, clients must send
# "Authorization: Bearer <token>". Leave empty for local development.
API_TOKEN=

# Rate limiting (sliding window per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Free Dictionary API (no key required; used for vocabulary lookup)
DICTIONARY_API_BASE=https://api.dictionaryapi.dev/api/v2/entries/en
